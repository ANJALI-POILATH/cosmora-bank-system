# Copy to server/.env and fill in. Never commit .env or the key file.

# --- Mode -------------------------------------------------------------------
# local    = JSON file + built-in X42 emulator (no Google credentials needed)
# firebase = cosmora-bank-732ca Firestore + Firebase Auth + live X42 Worker
# Leave unset to auto-pick: firebase if service-account.json exists, else local.
# DATA_MODE=local
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

PORT=4000
PORTAL_URL=http://localhost:5173

# --- Pre-created administrator ------------------------------------------------
ADMIN_EMAIL=admin@cosmora.bank
ADMIN_PASSWORD=
ADMIN_NAME=Cosmora Admin

# --- Local-mode token signing (use any long random string) ---------------------
TOKEN_SECRET=

# --- Email (Nodemailer). Leave SMTP_HOST empty to only save mail to the outbox.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cosmora Bank <no-reply@cosmora.bank>
