rules_version = '2';

// Browser (client SDK) access only. The Express server (firebase-admin) and the
// X42 Worker use service-account credentials, which bypass these rules, so
// portal_users, accounts, ledger_entries and the rest stay closed to browsers.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Every other path is denied by default.
  }
}
